# Copy to .env (worker, seed) AND frontend/.env.local (Next.js only reads env from its own folder).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker + seed script only. Never commit. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase MCP server (.mcp.json) only. A personal access token from
# https://supabase.com/dashboard/account/tokens — NOT a project key.
# Claude Code reads this from the OS environment, not from this file:
#   Windows:  setx SUPABASE_ACCESS_TOKEN "sbp_..."   (then restart Claude Code)
#   bash/zsh: export SUPABASE_ACCESS_TOKEN=sbp_...   (in your shell profile)
SUPABASE_ACCESS_TOKEN=
